{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Ionic dependencies",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "inAgents": true,
      "runOptions": {
        "runOn": "worktreeCreated"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Ionic app",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "inAgents": true,
      "problemMatcher": []
    }
  ]
}
